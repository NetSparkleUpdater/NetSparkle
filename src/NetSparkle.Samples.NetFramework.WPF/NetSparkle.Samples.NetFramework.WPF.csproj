<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NetSparkle.TestAppWPF</RootNamespace>
    <AssemblyName>NetSparkle.TestAppWPF</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>software-update-available.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSparkle.UI.WPF\NetSparkle.UI.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="software-update-available.ico" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>
</Project>
